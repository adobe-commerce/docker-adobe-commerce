#!/usr/bin/env bash
set -o errexit

# Copy Adobe Commerce-oriented compose tooling from this repo into the current (empty) directory.
# Use before bin/setup-commerce (see compose/COMMERCE.md).
#
#   mkdir -p ~/Sites/myproject && cd $_
#   bash /path/to/docker-adobe-commerce/lib/template-commerce

if [ -d "./bin" ]; then
  echo "Error: The current directory is not empty (found ./bin). Remove contents or use an empty directory."
  exit 1
fi

git init -qqq
git remote add origin https://github.com/adobe-commerce/docker-adobe-commerce
git fetch origin -qqq
git checkout origin/main -- compose

mv compose/* ./
mv compose/.gitignore ./
mv compose/.vscode ./
rm -rf compose .git
git init

# Ensure these are created so Docker doesn't create them as root
mkdir -p ~/.composer ~/.ssh
